rules_version = '2';

// Deployed by hand via the Firebase console (Firestore Database > Rules) --
// this project has no Firebase CLI/service-account wired up, so this file is
// the version-controlled source of truth, not something `firebase deploy`
// pushes automatically. Keep it in sync by hand whenever the rules change.
//
// Each game gets its own isXScore() validator, keyed off the `game` field,
// OR'd together in the one `allow create`. This is deliberate: a flat single
// field-list fails CLOSED on any field shape it wasn't written for, so a
// second game with a different schema would have every write silently
// rejected rather than just loosely accepted. Per-game functions mean
// adding a game is additive -- one new function + one new `||` clause --
// and no game's data can satisfy another game's validator (game code is
// checked inside each one), so nothing can spoof a different game's schema.
service cloud.firestore {
  match /databases/{database}/documents {

    // Single hardcoded admin uid (hardhatwarrior) -- there is exactly one site owner and no
    // multi-admin need, so a role field/collection would be pure overhead. Used to gate the
    // account-approval toggle and reading anyone else's private/ subcollection (recovery email).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'L44BFbmiNkhi2vvLdrPUIxkvmfs2';
    }

    // ---- username/password auth (see auth.js) ----
    //
    // usernames/{usernameLower} exists purely as a uniqueness reservation
    // (its content is just {uid}) -- allow create: if true never overlaps
    // with a duplicate claim, because a doc that already exists is
    // evaluated as an UPDATE, not a create, and update is always denied
    // below. That denial is the entire uniqueness guarantee; auth.js's
    // batch write relies on it (no read-then-check race is possible).
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && usernameLower == usernameLower.lower();
      // A username change (account page) releases the old reservation before claiming the new
      // one -- only the uid that holds a reservation can release it.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // users/{uid} is the public profile (username, `approved` status, and an optional 32x32
    // avatar -- a flat list of 1024 RGB444 words packed r|g<<4|b<<8 same as the tile editor's own
    // hexWord()). Public read because a username/avatar/approval status is shown on the
    // leaderboard and account/admin pages. Recovery email lives in a SEPARATE private/ subdoc
    // below -- keeping it off this document is the whole point (a publicly-readable doc can never
    // selectively hide one field from a direct query, so anything sensitive has to live somewhere
    // else entirely).
    match /users/{uid} {
      allow read: if true;

      function isWellFormedProfile(d) {
        return d.username is string
          && d.username.matches('^[A-Za-z0-9_]{3,16}$')
          && d.usernameLower == d.username.lower()
          && d.approved is bool
          && (!('avatar' in d) || (d.avatar is list && d.avatar.size() == 1024))
          && (!('wantsDev' in d) || d.wantsDev is bool)
          && (!('isDeveloper' in d) || d.isDeveloper is bool);
      }

      // New accounts always start unapproved (approved:false) -- nobody can self-approve at
      // signup; only isAdmin() can ever flip it true (see allow update below). Until approved,
      // the account can still sign in and submit scores (scores/{scoreId}'s own submitterApproved
      // check is what actually keeps those submissions off the public boards, not this).
      // `wantsDev` is a self-reported "I'd like to submit games" checkbox at signup -- purely
      // informational for the admin dashboard, grants nothing on its own. `isDeveloper` is the
      // real, admin-granted yes/no gate: not tied to any specific game, just "can this account
      // use /dev/submit/ at all" -- gameSubmissions/{id}'s own allow create checks it. A game's
      // developerUid still only ever gets set from a submission's own submitterUid at approval
      // time (or by the admin by hand) -- isDeveloper is the gate to get there, not the
      // assignment itself.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt', 'avatar', 'approved', 'wantsDev'])
        && request.resource.data.createdAt is int
        && request.resource.data.approved == false
        && isWellFormedProfile(request.resource.data);

      // Two distinct update paths, kept mutually exclusive by field scope:
      //  - the owner can change username/avatar (account page) but never their own `approved` or
      //    `isDeveloper` bits
      //  - the admin can flip `approved`/`wantsDev`/`isDeveloper` on any account, never touch
      //    anything else about it
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt', 'avatar', 'approved', 'wantsDev', 'isDeveloper'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.get('isDeveloper', false) == resource.data.get('isDeveloper', false)
          && isWellFormedProfile(request.resource.data))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'wantsDev', 'isDeveloper'])
          && request.resource.data.approved is bool
          && (!('wantsDev' in request.resource.data) || request.resource.data.wantsDev is bool)
          && (!('isDeveloper' in request.resource.data) || request.resource.data.isDeveloper is bool))
      );

      allow delete: if false;

      // Recovery email, split out from the parent doc specifically so it's never exposed by the
      // parent's own public `allow read: if true`. Only the owner and the admin can ever read or
      // write it. auth.js's updateRecoveryEmail() targets this doc (fixed id 'contact') instead of
      // the parent profile now.
      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid
          && docId == 'contact'
          && request.resource.data.keys().hasOnly(['recoveryEmail'])
          && (!('recoveryEmail' in request.resource.data) || request.resource.data.recoveryEmail is string);
        allow delete: if request.auth != null && request.auth.uid == uid && docId == 'contact';
      }
    }

    match /scores/{scoreId} {
      // A score is only publicly visible once its submitter's account is approved. IMPORTANT:
      // Firestore security rules can VALIDATE a write, but cannot reliably FILTER a list()/query
      // result based on a get() to a different document -- a get()-based check here only works
      // for a single-document read, not for the actual board queries every game page runs. (An
      // earlier version of this rule assumed otherwise; verified wrong in production -- an
      // unapproved account's score was publicly visible on the real board query.) So `approved`
      // is denormalized directly onto the score doc itself at write time (see hasValidIdentity),
      // kept in sync by admin/index.html's approve/revoke action batch-updating every score by
      // that uid, and the read rule below is a plain field check -- provably filterable by
      // Firestore for list() queries, which is exactly why every game's board query itself also
      // has an explicit `.where('approved','==',true)`; the rule is the backstop, the query is
      // what actually keeps a non-compliant doc from ever being fetched. A pre-sign-in-required
      // score with no uid at all (from before that policy) has no submitter to gate on, so it
      // stays visible as-is (backfilled with approved:true -- see backfill-score-approved.js).
      // Deliberately does NOT add an "owner can always read their own" clause here even though
      // that seems like an obvious addition (account/index.html's "Your Submissions" list wanting
      // to show a still-pending account's own scores back to them) -- mixing a
      // request.auth-uid-vs-resource.data-field comparison into this OR breaks the "provably
      // filterable" property list() queries need: confirmed in production, a plain
      // .where('uid','==',someUid).get() (no other filter) started throwing a flat
      // permission-denied for the WHOLE query the moment that clause existed, for EVERY caller
      // (not just cross-user queries) -- Firestore's query-safety check is evaluated statically
      // against the rule text as a whole, not per specific query, so one unprovable OR-branch
      // poisons list() access to the entire collection. isAdmin() does NOT have this problem --
      // it depends only on request.auth, never on resource.data, so it stays a fixed true/false
      // for a given caller across every document, which Firestore CAN prove safe (this is the
      // same reason every other collection's isAdmin()-gated read/write in this file works fine
      // for queries). That's what makes admin/index.html's approve/revoke fan-out
      // (.where('uid','==',uid).get(), no approved filter, needs to see NOT-yet-approved docs to
      // flip them) possible at all. "Your Submissions" still can't show a still-pending score --
      // the account page isn't the admin -- so its own query adds an explicit
      // .where('approved','==',true) instead, same pattern as every board query, trading
      // "shows only approved" for "doesn't error."
      allow read: if !('uid' in resource.data) || resource.data.approved == true || isAdmin();

      // A score's uid/username pair is required (anonymous QR submission was retired) and can't
      // be spoofed: uid must match the actual signed-in caller, and username is shape-checked even
      // though it's just a denormalized copy of users/{uid}.username (not re-verified against that
      // doc -- acceptable here since it can only ever be set to request.auth's OWN uid, so at
      // worst a stale username after a future rename, not another user's identity). `approved`
      // MUST match the submitter's actual current users/{uid}.approved at write time -- this one
      // get() is fine because it's a single-document read on a create, not a list() query.
      function hasValidIdentity(d) {
        return ('uid' in d) && ('username' in d) && ('approved' in d)
          && request.auth != null && request.auth.uid == d.uid
          && d.username is string && d.username.matches('^[A-Za-z0-9_]{3,16}$')
          && d.approved is bool
          && d.approved == get(/databases/$(database)/documents/users/$(d.uid)).data.approved;
      }

      // Matches the object lb/index.html's writeScore() builds (game, initials, score, weight,
      // rolls, source, submittedAt, plus required uid/username from auth.js).
      function isBowlingScore(d) {
        return d.game == 'BW'
          && d.keys().hasOnly(['game', 'initials', 'score', 'weight', 'rolls', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 300
          && d.weight is int && d.weight >= 1 && d.weight <= 99
          && d.rolls is list && d.rolls.size() >= 12 && d.rolls.size() <= 21
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Matches tetris/index.html's writeScore() call (game, initials, score, lines, level,
      // source, submittedAt, plus required uid/username) -- field widths mirror the on-device QR
      // payload's own fixed-width digit fields (8-digit score, 5-digit lines, 3-digit level; see
      // Tetris's main.c qr_build_payload()).
      function isTetrisScore(d) {
        return d.game == 'TT'
          && d.keys().hasOnly(['game', 'initials', 'score', 'lines', 'level', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999999
          && d.lines is int && d.lines >= 0 && d.lines <= 99999
          && d.level is int && d.level >= 0 && d.level <= 999
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Yahtzee: game, initials, score, categoryScores (13 ints), source, submittedAt,
      // required uid/username.
      function isYahtzeeScore(d) {
        return d.game == 'YZ'
          && d.keys().hasOnly(['game', 'initials', 'score', 'categoryScores', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999
          && d.categoryScores is list && d.categoryScores.size() == 13
          && d.categoryScores[0] is int && d.categoryScores[0] >= 0 && d.categoryScores[0] <= 30  // ones-sixes
          && d.categoryScores[1] is int && d.categoryScores[1] >= 0 && d.categoryScores[1] <= 30
          && d.categoryScores[2] is int && d.categoryScores[2] >= 0 && d.categoryScores[2] <= 30
          && d.categoryScores[3] is int && d.categoryScores[3] >= 0 && d.categoryScores[3] <= 30
          && d.categoryScores[4] is int && d.categoryScores[4] >= 0 && d.categoryScores[4] <= 30
          && d.categoryScores[5] is int && d.categoryScores[5] >= 0 && d.categoryScores[5] <= 30
          && d.categoryScores[6] is int && d.categoryScores[6] >= 0 && d.categoryScores[6] <= 30  // 3-kind through chance
          && d.categoryScores[7] is int && d.categoryScores[7] >= 0 && d.categoryScores[7] <= 30
          && d.categoryScores[8] is int && d.categoryScores[8] >= 0 && d.categoryScores[8] <= 25  // full house
          && d.categoryScores[9] is int && d.categoryScores[9] >= 0 && d.categoryScores[9] <= 30  // small straight
          && d.categoryScores[10] is int && d.categoryScores[10] >= 0 && d.categoryScores[10] <= 40  // large straight
          && d.categoryScores[11] is int && d.categoryScores[11] >= 0 && d.categoryScores[11] <= 50  // yahtzee
          && d.categoryScores[12] is int && d.categoryScores[12] >= 0 && d.categoryScores[12] <= 30  // chance
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Farkle: game, initials, score, rounds, opened, farkles, resultChar, resultDisplay,
      // source, submittedAt, required uid/username.
      function isFarkleScore(d) {
        return d.game == 'FK'
          && d.keys().hasOnly(['game', 'initials', 'score', 'rounds', 'opened', 'farkles', 'resultChar', 'resultDisplay', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.rounds is int && d.rounds >= 0 && d.rounds <= 999
          && d.opened is int && d.opened >= 0 && d.opened <= 999
          && d.farkles is int && d.farkles >= 0 && d.farkles <= 999
          && d.resultChar is string && d.resultChar.matches('^[1WLD]$')
          && d.resultDisplay is string && d.resultDisplay.matches('^(SOLO|WIN|LOSS|DRAW)$')
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // 2048: game, initials, score, moves, source, submittedAt, required uid/username -- field
      // widths mirror the on-device QR payload's own fixed-width digit fields (5-digit score,
      // 4-digit moves; see 2048's main.c qr_build_payload()).
      function is2048Score(d) {
        return d.game == '2K'
          && d.keys().hasOnly(['game', 'initials', 'score', 'moves', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.moves is int && d.moves >= 0 && d.moves <= 9999
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Over Rev: game, initials (1-8 chars, not 3 -- this game's QR carries a free-typed name,
      // not fixed initials), rules/course/car/tune/mode/difficulty/transmission/ticks/won/
      // localRecord/event/sequence/raw, source, submittedAt, required uid/username. Sorted
      // ascending by ticks on the leaderboard (lower is better), unlike every other game here.
      // Shape/bounds only -- does not re-verify the OV1 Base32/CRC24 encoding itself; see
      // overrev-leaderboard-kit/README.md for why that's a client-side-only guarantee.
      function isOverRevScore(d) {
        return d.game == 'OV'
          && d.keys().hasOnly(['game', 'initials', 'rules', 'course', 'car', 'tune', 'mode', 'difficulty', 'transmission', 'ticks', 'won', 'localRecord', 'event', 'sequence', 'raw', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z0-9]{1,8}$')
          && d.rules is int && d.rules == 1
          && d.course is int && d.course >= 0 && d.course < 10
          && d.car is int && d.car >= 0 && d.car < 8
          && d.tune is int && d.tune >= 0 && d.tune <= 255
          && d.mode is int && d.mode == 1
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 3
          && d.transmission is string && d.transmission in ['AT', 'MT']
          && d.ticks is int && d.ticks >= 1 && d.ticks <= 65535
          && d.won is bool && d.localRecord is bool
          && d.event is int && d.event == 0
          && d.sequence is int && d.sequence >= 0 && d.sequence <= 65535
          && d.raw is string && d.raw.matches('^OV1:[A-Z0-9]{1,8}:[A-Z2-7]{24}$')
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Gardenia: game, mode (1 Picnic/2 Gardener/3 Landscaper), initials, score,
      // startLevel/levelReached (info only, not re-derived or bounds-checked against each other),
      // source, submittedAt, required uid/username. Field widths mirror the author's own QR
      // spec's fixed-width digit fields (5-digit score, 2-digit level fields). Sorted descending
      // by score, scoped to one mode at a time -- see gd/index.html's own board query.
      function isGardeniaScore(d) {
        return d.game == 'GD'
          && d.keys().hasOnly(['game', 'mode', 'initials', 'score', 'startLevel', 'levelReached', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.mode is int && d.mode >= 1 && d.mode <= 3
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999
          && d.startLevel is int && d.startLevel >= 0 && d.startLevel <= 99
          && d.levelReached is int && d.levelReached >= 0 && d.levelReached <= 99
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Sudoku: game, difficulty (E/M/H), time (seconds, 1-5 digits per the submission's own
      // spec), misses (3-digit zero-padded mistake count), source, submittedAt, required
      // uid/username -- no initials field, unlike every other game here; Sudoku's own high-score
      // flow doesn't collect device-typed initials. Sorted ascending by time (faster wins),
      // scoped to one difficulty at a time -- approved via /dev/submit/ -> admin/index.html's
      // submission review, same path any future developer submission goes through.
      function isSudokuScore(d) {
        return d.game == 'SD'
          && d.keys().hasOnly(['game', 'difficulty', 'time', 'misses', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.difficulty is string && d.difficulty in ['E', 'M', 'H']
          && d.time is int && d.time >= 0 && d.time <= 99999
          && d.misses is int && d.misses >= 0 && d.misses <= 999
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Xenon 2: game, initials, score, money, checkpoint, livesLeft, source, submittedAt,
      // required uid/username. Third-party (firmware not in this workspace) -- shape/bounds only,
      // per the developer's own submitted spec (fixed-width, no delimiters, no URL: the raw QR
      // text is bare "XN" + fields, unlike every other game's URL-prefixed payload -- see
      // xn/index.html's own parser comment). Score is sent as a final total, not reconstructed
      // from raw inputs (a scrolling shooter has no short list of replayable events the way
      // Bowling's rolls or Yahtzee's categories do, per the submission's own scorecardFormula);
      // checkpoint/livesLeft/money are plausibility anchors and detail-view fields, not derived
      // from score or from each other.
      function isXenon2Score(d) {
        return d.game == 'XN'
          && d.keys().hasOnly(['game', 'initials', 'score', 'money', 'checkpoint', 'livesLeft', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999999
          && d.money is int && d.money >= 0 && d.money <= 65535
          && d.checkpoint is int && d.checkpoint >= 0 && d.checkpoint <= 7
          && d.livesLeft is int && d.livesLeft >= 0 && d.livesLeft <= 9
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      allow create: if isBowlingScore(request.resource.data) || isTetrisScore(request.resource.data) || isYahtzeeScore(request.resource.data) || isFarkleScore(request.resource.data) || is2048Score(request.resource.data) || isOverRevScore(request.resource.data) || isGardeniaScore(request.resource.data) || isSudokuScore(request.resource.data) || isXenon2Score(request.resource.data);

      // Only the admin, and only the `approved` field -- fans out an account approve/revoke
      // (admin/index.html) to every score that account already submitted, so a toggle's effect on
      // board visibility is immediate for past scores too, not just ones submitted from then on.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;
      // A signed-in user can delete their own score (account page's "Your Submissions" list) --
      // anonymous QR submissions have no uid at all, so resource.data.uid == request.auth.uid is
      // false for them (never true against a signed-in caller's uid), and they stay undeletable
      // by anyone except the admin. isAdmin() also covers admin/index.html's own site-wide
      // "All Submissions" panel, which needs to delete any score regardless of submitter.
      allow delete: if request.auth != null
        && (('uid' in resource.data) && resource.data.uid == request.auth.uid || isAdmin());
    }

    // games/{slug} is the main page's authoritative tile data (name, dev status, ROM location,
    // last-updated) -- index.html renders its grid FROM this collection instead of hardcoded
    // HTML, so a game's own assigned developer can update their dev status and ROM without
    // ever touching a file in this repo. Split-permission by field, same pattern as users/{uid}:
    // the admin owns identity fields (name/code/titleImage/leaderboardPath/addedAt/developerUid
    // -- adding a game or reassigning its developer is an admin action), while the assigned
    // developer can only touch the fields describing their own build.
    match /games/{slug} {
      allow read: if true;

      function isAssignedDev(d) {
        return request.auth != null && ('developerUid' in d) && d.developerUid == request.auth.uid;
      }

      allow create: if isAdmin();
      // 'coming-soon' is a devStatus a game's own developer can opt into at their own discretion
      // (see admin/game/index.html's status buttons), right from the moment their submission is
      // approved -- the main page shows a bottom banner and suppresses the NEW/UPDATED corner
      // ribbon entirely while set. newUntil is included here alongside devStatus because leaving
      // coming-soon resets it to a fresh 30-day window (that's the moment NEW should actually
      // start counting down, not back at approval time) -- same trust level already granted for
      // updatedUntil below, only ever a cosmetic ribbon either way.
      allow update: if request.auth != null && (
        isAdmin()
        || (isAssignedDev(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devStatus', 'romPath', 'romFileName', 'romUpdatedAt', 'updatedUntil', 'newUntil'])
            && request.resource.data.devStatus in ['coming-soon', 'dev', 'beta', 'final'])
      );
      allow delete: if isAdmin();
    }

    // gameSubmissions/{id} -- a new-game proposal from a prospective developer: ROM + title
    // screenshot (Storage paths, see storage.rules' submissions/{uid}/{subId}/ block) plus a
    // structured payload spec (field layout, sort field, scorecard formula, example payloads --
    // the same shape NGPC-QR-SDK/SUBMISSION_TEMPLATE.md asks a developer to fill out by hand,
    // just captured as data here instead of chased down over chat). Private to the submitter and
    // the admin -- an unreviewed submission was never meant to be public. Approving one is still
    // a manual admin action elsewhere (creating the real games/{slug} doc, and -- outside this
    // rules file entirely -- hand-building that game's own leaderboard page and score-shape
    // validator, the same way every game here always has been); this collection only removes the
    // "chase the developer for details" step, not that build step.
    match /gameSubmissions/{id} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.submitterUid || isAdmin());

      // Gated behind users/{uid}.isDeveloper -- the account-level yes/no the admin grants from
      // the Players table, not tied to any specific game (see users/{uid}'s own comment). One
      // get() here is fine; it's a create, not a list() query.
      allow create: if request.auth != null
        && request.resource.data.submitterUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDeveloper', false) == true
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
             'submitterUid', 'submitterUsername', 'proposedName', 'proposedCode',
             'romPath', 'romFileName', 'screenshotPath', 'payloadFields', 'totalLength',
             'sortField', 'sortDirection', 'scorecardFormula', 'examplePayloads', 'otherNotes',
             'status', 'submittedAt', 'reviewedAt', 'reviewNote'
           ])
        && request.resource.data.proposedName is string
        && request.resource.data.proposedCode is string && request.resource.data.proposedCode.matches('^[A-Z0-9]{2,6}$')
        && request.resource.data.submittedAt is int;

      // The submitter can still edit their own submission while it's pending (fix a typo before
      // review); once the admin has reviewed it (approved or rejected), it's a permanent record --
      // only the admin can touch a reviewed submission (e.g. to correct a reviewNote).
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == resource.data.submitterUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.submitterUid == resource.data.submitterUid)
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.submitterUid && resource.data.status == 'pending';
    }

    // Landing page's raw page-view counter (index.html only). meta/siteStats is pre-created by
    // hand via the console with just {pageViews: 0} -- allow create is deliberately false so a
    // client can never spoof its shape or seed an arbitrary starting value. Anonymous write is
    // intentional (most visitors aren't signed in and should still be counted), but constrained
    // to exactly a same-field +1 per write: FieldValue.increment() resolves before rules
    // evaluate, so request.resource.data.pageViews already reflects the post-increment value here
    // -- a client still can't ever set it to an arbitrary/negative number or touch any other key.
    // meta/siteSettings -- admin-only site config, currently just hideGamesGrid (a testing switch
    // that hides the homepage's whole games grid for every visitor, admin included, so the admin
    // can see exactly what the public sees while it's on). Unlike siteStats above, this one IS
    // self-service-creatable (by the admin only) since there's only one admin and no meaningful
    // "wrong starting value" risk the way an anonymous-writable counter has.
    match /meta/{docId} {
      allow read: if true;
      allow create: if docId == 'siteSettings' && isAdmin()
        && request.resource.data.keys().hasOnly(['hideGamesGrid'])
        && request.resource.data.hideGamesGrid is bool;
      allow update: if (docId == 'siteStats'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews'])
          && request.resource.data.pageViews == resource.data.pageViews + 1)
        || (docId == 'siteSettings' && isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hideGamesGrid'])
          && request.resource.data.hideGamesGrid is bool);
      allow delete: if false;
    }

    // pageViews/{pathKey} + pageViewsDaily/{pathKey_YYYYMMDD} -- site-wide per-page traffic,
    // written by auth.js's trackPageView() on every page load (every game board, the homepage,
    // account/admin/user pages), read only by admin/index.html's own Site Stats panel. Separate
    // from meta/siteStats above (index.html's own single-number visible counter, pre-seeded by
    // hand) -- these are self-service documents instead, since new pages/days appear over time and
    // pre-seeding one by hand for each isn't practical. Same FieldValue.increment()-resolves-
    // before-rules-evaluate trick as meta/siteStats keeps a client from setting either counter to
    // an arbitrary value: a create must start at exactly 1, and an update may only step the count
    // field by exactly +1, touching no other field.
    match /pageViews/{pathKey} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['path', 'total', 'lastViewedAt'])
        && request.resource.data.path is string
        && request.resource.data.total == 1
        && request.resource.data.lastViewedAt is int;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'lastViewedAt'])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.lastViewedAt is int;
      allow delete: if false;
    }
    match /pageViewsDaily/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['path', 'date', 'count'])
        && request.resource.data.path is string
        && request.resource.data.date is string
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // mail/{id} -- watched by the Firebase "Trigger Email" extension (Admin SDK only; installed
    // separately from the Firebase Console), which turns each doc into a real email and then
    // writes delivery status back onto it. Written by auth.js's notifyAdmin() on a new signup and
    // by dev/submit/index.html on a new game submission. The recipient is hardcoded to a single
    // literal address here -- NOT just trusted from the client -- so nothing a client sends can
    // redirect a notification to an arbitrary inbox; this is a fixed admin alert channel, not a
    // general mailer. No read/update/delete for any client: only the extension's own Admin SDK
    // (which bypasses rules entirely) ever touches a doc after creation.
    match /mail/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] == 'darekdavis@gmail.com'
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string;
    }

    // Default-deny for every other collection -- Firestore denies unmatched
    // paths by default anyway, but this makes the intent explicit as the
    // schema grows (Phase 3 comments/, etc).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
