rules_version = '2';

// Deployed by hand via the Firebase console (Firestore Database > Rules) --
// this project has no Firebase CLI/service-account wired up, so this file is
// the version-controlled source of truth, not something `firebase deploy`
// pushes automatically. Keep it in sync by hand whenever the rules change.
//
// Each game gets its own isXScore() validator, keyed off the `game` field,
// OR'd together in the one `allow create`. This is deliberate: a flat single
// field-list fails CLOSED on any field shape it wasn't written for, so a
// second game with a different schema would have every write silently
// rejected rather than just loosely accepted. Per-game functions mean
// adding a game is additive -- one new function + one new `||` clause --
// and no game's data can satisfy another game's validator (game code is
// checked inside each one), so nothing can spoof a different game's schema.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- username/password auth (see auth.js) ----
    //
    // usernames/{usernameLower} exists purely as a uniqueness reservation
    // (its content is just {uid}) -- allow create: if true never overlaps
    // with a duplicate claim, because a doc that already exists is
    // evaluated as an UPDATE, not a create, and update is always denied
    // below. That denial is the entire uniqueness guarantee; auth.js's
    // batch write relies on it (no read-then-check race is possible).
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && usernameLower == usernameLower.lower();
      // A username change (account page) releases the old reservation before claiming the new
      // one -- only the uid that holds a reservation can release it.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // users/{uid} is the public profile (username, optional recovery email -- never read back by
    // any page today, collected for a future recovery flow -- and an optional 32x32 avatar, a
    // flat list of 1024 RGB444 words packed r|g<<4|b<<8 same as the tile editor's own hexWord()).
    // Public read because a username/avatar is shown on the leaderboard next to a score.
    match /users/{uid} {
      allow read: if true;

      function isWellFormedProfile(d) {
        return d.username is string
          && d.username.matches('^[A-Za-z0-9_]{3,16}$')
          && d.usernameLower == d.username.lower()
          && (!('recoveryEmail' in d) || d.recoveryEmail is string)
          && (!('avatar' in d) || (d.avatar is list && d.avatar.size() == 1024));
      }

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'recoveryEmail', 'createdAt', 'avatar'])
        && request.resource.data.createdAt is int
        && isWellFormedProfile(request.resource.data);

      // Account page: username/email/avatar can change, createdAt cannot.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'recoveryEmail', 'createdAt', 'avatar'])
        && request.resource.data.createdAt == resource.data.createdAt
        && isWellFormedProfile(request.resource.data);

      allow delete: if false;
    }

    match /scores/{scoreId} {
      // Public leaderboard -- anyone can read, signing in is never required to browse.
      allow read: if true;

      // A score's uid/username pair is optional (anonymous QR submission keeps working exactly
      // as before) but when present must be internally consistent and can't be spoofed: both
      // fields travel together, uid must match the actual signed-in caller, and username is
      // still shape-checked even though it's just a denormalized copy of users/{uid}.username
      // (not re-verified against that doc -- acceptable here since it can only ever be set to
      // request.auth's OWN uid, so at worst a stale username after a future rename, not another
      // user's identity).
      function hasValidIdentity(d) {
        return (('uid' in d) == ('username' in d))
          && (!('uid' in d) || (request.auth != null && request.auth.uid == d.uid))
          && (!('username' in d) || (d.username is string && d.username.matches('^[A-Za-z0-9_]{3,16}$')));
      }

      // Matches the object lb/index.html's writeScore() builds (game, initials, score, weight,
      // rolls, source, submittedAt, plus optional uid/username from auth.js).
      function isBowlingScore(d) {
        return d.game == 'BW'
          && d.keys().hasOnly(['game', 'initials', 'score', 'weight', 'rolls', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 300
          && d.weight is int && d.weight >= 1 && d.weight <= 99
          && d.rolls is list && d.rolls.size() >= 12 && d.rolls.size() <= 21
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Matches tetris/index.html's writeScore() call (game, initials, score, lines, level,
      // source, submittedAt, plus optional uid/username) -- field widths mirror the on-device QR
      // payload's own fixed-width digit fields (8-digit score, 5-digit lines, 3-digit level; see
      // Tetris's main.c qr_build_payload()).
      function isTetrisScore(d) {
        return d.game == 'TT'
          && d.keys().hasOnly(['game', 'initials', 'score', 'lines', 'level', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999999
          && d.lines is int && d.lines >= 0 && d.lines <= 99999
          && d.level is int && d.level >= 0 && d.level <= 999
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Yahtzee: game, initials, score, categoryScores (13 ints), source, submittedAt,
      // optional uid/username.
      function isYahtzeeScore(d) {
        return d.game == 'YZ'
          && d.keys().hasOnly(['game', 'initials', 'score', 'categoryScores', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999
          && d.categoryScores is list && d.categoryScores.size() == 13
          && d.categoryScores[0] is int && d.categoryScores[0] >= 0 && d.categoryScores[0] <= 30  // ones-sixes
          && d.categoryScores[1] is int && d.categoryScores[1] >= 0 && d.categoryScores[1] <= 30
          && d.categoryScores[2] is int && d.categoryScores[2] >= 0 && d.categoryScores[2] <= 30
          && d.categoryScores[3] is int && d.categoryScores[3] >= 0 && d.categoryScores[3] <= 30
          && d.categoryScores[4] is int && d.categoryScores[4] >= 0 && d.categoryScores[4] <= 30
          && d.categoryScores[5] is int && d.categoryScores[5] >= 0 && d.categoryScores[5] <= 30
          && d.categoryScores[6] is int && d.categoryScores[6] >= 0 && d.categoryScores[6] <= 30  // 3-kind through chance
          && d.categoryScores[7] is int && d.categoryScores[7] >= 0 && d.categoryScores[7] <= 30
          && d.categoryScores[8] is int && d.categoryScores[8] >= 0 && d.categoryScores[8] <= 25  // full house
          && d.categoryScores[9] is int && d.categoryScores[9] >= 0 && d.categoryScores[9] <= 30  // small straight
          && d.categoryScores[10] is int && d.categoryScores[10] >= 0 && d.categoryScores[10] <= 40  // large straight
          && d.categoryScores[11] is int && d.categoryScores[11] >= 0 && d.categoryScores[11] <= 50  // yahtzee
          && d.categoryScores[12] is int && d.categoryScores[12] >= 0 && d.categoryScores[12] <= 30  // chance
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Farkle: game, initials, score, rounds, opened, farkles, resultChar, resultDisplay,
      // source, submittedAt, optional uid/username.
      function isFarkleScore(d) {
        return d.game == 'FK'
          && d.keys().hasOnly(['game', 'initials', 'score', 'rounds', 'opened', 'farkles', 'resultChar', 'resultDisplay', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.rounds is int && d.rounds >= 0 && d.rounds <= 999
          && d.opened is int && d.opened >= 0 && d.opened <= 999
          && d.farkles is int && d.farkles >= 0 && d.farkles <= 999
          && d.resultChar is string && d.resultChar.matches('^[1WLD]$')
          && d.resultDisplay is string && d.resultDisplay.matches('^(SOLO|WIN|LOSS|DRAW)$')
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // 2048: game, initials, score, moves, source, submittedAt, optional uid/username -- field
      // widths mirror the on-device QR payload's own fixed-width digit fields (5-digit score,
      // 4-digit moves; see 2048's main.c qr_build_payload()).
      function is2048Score(d) {
        return d.game == '2K'
          && d.keys().hasOnly(['game', 'initials', 'score', 'moves', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.moves is int && d.moves >= 0 && d.moves <= 9999
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Over Rev: game, initials (1-8 chars, not 3 -- this game's QR carries a free-typed name,
      // not fixed initials), rules/course/car/tune/mode/difficulty/transmission/ticks/won/
      // localRecord/event/sequence/raw, source, submittedAt, optional uid/username. Sorted
      // ascending by ticks on the leaderboard (lower is better), unlike every other game here.
      // Shape/bounds only -- does not re-verify the OV1 Base32/CRC24 encoding itself; see
      // overrev-leaderboard-kit/README.md for why that's a client-side-only guarantee.
      function isOverRevScore(d) {
        return d.game == 'OV'
          && d.keys().hasOnly(['game', 'initials', 'rules', 'course', 'car', 'tune', 'mode', 'difficulty', 'transmission', 'ticks', 'won', 'localRecord', 'event', 'sequence', 'raw', 'source', 'submittedAt', 'uid', 'username'])
          && d.initials is string && d.initials.matches('^[A-Z0-9]{1,8}$')
          && d.rules is int && d.rules == 1
          && d.course is int && d.course >= 0 && d.course < 10
          && d.car is int && d.car >= 0 && d.car < 8
          && d.tune is int && d.tune >= 0 && d.tune <= 255
          && d.mode is int && d.mode == 1
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 3
          && d.transmission is string && d.transmission in ['AT', 'MT']
          && d.ticks is int && d.ticks >= 1 && d.ticks <= 65535
          && d.won is bool && d.localRecord is bool
          && d.event is int && d.event == 0
          && d.sequence is int && d.sequence >= 0 && d.sequence <= 65535
          && d.raw is string && d.raw.matches('^OV1:[A-Z0-9]{1,8}:[A-Z2-7]{24}$')
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Gardenia: game, mode (1 Picnic/2 Gardener/3 Landscaper), initials, score,
      // startLevel/levelReached (info only, not re-derived or bounds-checked against each other),
      // source, submittedAt, optional uid/username. Field widths mirror the author's own QR
      // spec's fixed-width digit fields (5-digit score, 2-digit level fields). Sorted descending
      // by score, scoped to one mode at a time -- see gardenia/index.html's own board query.
      function isGardeniaScore(d) {
        return d.game == 'GD'
          && d.keys().hasOnly(['game', 'mode', 'initials', 'score', 'startLevel', 'levelReached', 'source', 'submittedAt', 'uid', 'username'])
          && d.mode is int && d.mode >= 1 && d.mode <= 3
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999
          && d.startLevel is int && d.startLevel >= 0 && d.startLevel <= 99
          && d.levelReached is int && d.levelReached >= 0 && d.levelReached <= 99
          && d.source is string && d.source == 'qr'
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      allow create: if isBowlingScore(request.resource.data) || isTetrisScore(request.resource.data) || isYahtzeeScore(request.resource.data) || isFarkleScore(request.resource.data) || is2048Score(request.resource.data) || isOverRevScore(request.resource.data) || isGardeniaScore(request.resource.data);

      allow update: if false;
      // A signed-in user can delete their own score (account page's "Your Submissions" list) --
      // anonymous QR submissions have no uid at all, so resource.data.uid == request.auth.uid is
      // false for them (never true against a signed-in caller's uid), and they stay undeletable
      // by anyone.
      allow delete: if request.auth != null
        && ('uid' in resource.data) && resource.data.uid == request.auth.uid;
    }

    // Landing page's raw page-view counter (index.html only). meta/siteStats is pre-created by
    // hand via the console with just {pageViews: 0} -- allow create is deliberately false so a
    // client can never spoof its shape or seed an arbitrary starting value. Anonymous write is
    // intentional (most visitors aren't signed in and should still be counted), but constrained
    // to exactly a same-field +1 per write: FieldValue.increment() resolves before rules
    // evaluate, so request.resource.data.pageViews already reflects the post-increment value here
    // -- a client still can't ever set it to an arbitrary/negative number or touch any other key.
    match /meta/{docId} {
      allow read: if true;
      allow create: if false;
      allow update: if docId == 'siteStats'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews'])
        && request.resource.data.pageViews == resource.data.pageViews + 1;
      allow delete: if false;
    }

    // Default-deny for every other collection -- Firestore denies unmatched
    // paths by default anyway, but this makes the intent explicit as the
    // schema grows (Phase 3 comments/, etc).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
