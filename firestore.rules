rules_version = '2';

// Deployed by hand via the Firebase console (Firestore Database > Rules) --
// this project has no Firebase CLI/service-account wired up, so this file is
// the version-controlled source of truth, not something `firebase deploy`
// pushes automatically. Keep it in sync by hand whenever the rules change.
//
// Each game gets its own isXScore() validator, keyed off the `game` field,
// OR'd together in the one `allow create`. This is deliberate: a flat single
// field-list fails CLOSED on any field shape it wasn't written for, so a
// second game with a different schema would have every write silently
// rejected rather than just loosely accepted. Per-game functions mean
// adding a game is additive -- one new function + one new `||` clause --
// and no game's data can satisfy another game's validator (game code is
// checked inside each one), so nothing can spoof a different game's schema.
service cloud.firestore {
  match /databases/{database}/documents {

    // The hardcoded site owner (hardhatwarrior) is ALWAYS an admin, full stop -- that part never
    // depends on any Firestore data. On top of that, the owner can grant the same access to
    // another account via users/{uid}.admin (see that collection's own allow update below, and
    // admin/index.html's promote-admin/demote-admin toggle) -- this get() only ever reads the
    // CALLER's own doc, keyed off request.auth (never resource.data), so it's still a fixed
    // true/false for a given caller across every document in a request, same as the plain uid
    // check used to be -- see scores/{scoreId}'s own comment on why that property is required for
    // isAdmin() to keep working inside a list() query's rule, not just single-document reads.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'L44BFbmiNkhi2vvLdrPUIxkvmfs2'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true
      );
    }

    // ---- username/password auth (see auth.js) ----
    //
    // usernames/{usernameLower} exists purely as a uniqueness reservation
    // (its content is just {uid}) -- allow create: if true never overlaps
    // with a duplicate claim, because a doc that already exists is
    // evaluated as an UPDATE, not a create, and update is always denied
    // below. That denial is the entire uniqueness guarantee; auth.js's
    // batch write relies on it (no read-then-check race is possible).
    match /usernames/{usernameLower} {
      allow read: if true;
      // ...and only as part of creating the profile that carries that name (auth.js signUp writes
      // both in one batch, so getAfter() sees the new users doc) -- since usernames are permanent,
      // an existing account can't reserve extra names. Paired with users/{uid}'s create check
      // below, which is Firebase's standard unique-username pattern: each side requires the other.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && usernameLower == usernameLower.lower()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == usernameLower;
      // Usernames are permanent (every score a player submits is listed under theirs, and
      // sign-in maps it to the account's synthetic Auth email) -- reservations are never released
      // by clients. A needed correction goes through NGPC-Admin-Scripts/rename-user.js, which uses
      // the Admin SDK (bypasses these rules) to move the reservation, the profile, the Auth email
      // and every score's denormalized username together.
      allow delete: if false;
      allow update: if false;
    }

    // users/{uid} is the public profile (username, `approved` status, and an optional 32x32
    // avatar -- a flat list of 1024 RGB444 words packed r|g<<4|b<<8 same as the tile editor's own
    // hexWord()). Public read because a username/avatar/approval status is shown on the
    // leaderboard and account/admin pages. Recovery email lives in a SEPARATE private/ subdoc
    // below -- keeping it off this document is the whole point (a publicly-readable doc can never
    // selectively hide one field from a direct query, so anything sensitive has to live somewhere
    // else entirely).
    match /users/{uid} {
      allow read: if true;

      function isWellFormedProfile(d) {
        return d.username is string
          && d.username.matches('^[A-Za-z0-9_]{3,16}$')
          && d.usernameLower == d.username.lower()
          && d.approved is bool
          && (!('avatar' in d) || (d.avatar is list && d.avatar.size() == 1024))
          && (!('wantsDev' in d) || d.wantsDev is bool)
          && (!('isDeveloper' in d) || d.isDeveloper is bool)
          && (!('admin' in d) || d.admin is bool)
          && (!('defaultInitials' in d) || (d.defaultInitials is string && d.defaultInitials.matches('^[A-Z0-9]{1,3}$')));
      }

      // New accounts always start unapproved (approved:false) -- nobody can self-approve at
      // signup; only isAdmin() can ever flip it true (see allow update below). Until approved,
      // the account can still sign in and submit scores (scores/{scoreId}'s own submitterApproved
      // check is what actually keeps those submissions off the public boards, not this).
      // `wantsDev` is a self-reported "I'd like to submit games" checkbox at signup -- purely
      // informational for the admin dashboard, grants nothing on its own. `isDeveloper` is the
      // real, admin-granted yes/no gate: not tied to any specific game, just "can this account
      // use /dev/submit/ at all" -- gameSubmissions/{id}'s own allow create checks it. A game's
      // developerUid still only ever gets set from a submission's own submitterUid at approval
      // time (or by the admin by hand) -- isDeveloper is the gate to get there, not the
      // assignment itself.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt', 'avatar', 'approved', 'wantsDev'])
        && request.resource.data.createdAt is int
        && request.resource.data.approved == false
        && isWellFormedProfile(request.resource.data)
        // The username must be reserved to THIS account in the same batch (see usernames above).
        // Without this a client could create its profile under any name -- including someone
        // else's -- skipping the reservation, and every score's username check
        // (hasValidIdentity) would then accept that borrowed name.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;

      // Two distinct update paths, kept mutually exclusive by field scope:
      //  - the owner can change their avatar (account page) but never their username (permanent --
      //    see usernames/{usernameLower} above; admin-only via rename-user.js) or their own
      //    `approved`, `isDeveloper`, or `admin` bits
      //  - the admin can flip `approved`/`wantsDev`/`isDeveloper`/`admin` on any account, never
      //    touch anything else about it. `admin` is the same site-wide privilege isAdmin() grants
      //    the hardcoded owner uid, just extendable to another account by the owner (or any other
      //    admin) -- see admin/index.html's promote-admin/demote-admin toggle.
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt', 'avatar', 'approved', 'wantsDev', 'isDeveloper', 'admin', 'defaultInitials'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.username == resource.data.username
          && request.resource.data.usernameLower == resource.data.usernameLower
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.get('isDeveloper', false) == resource.data.get('isDeveloper', false)
          && request.resource.data.get('admin', false) == resource.data.get('admin', false)
          && isWellFormedProfile(request.resource.data))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'wantsDev', 'isDeveloper', 'admin'])
          && request.resource.data.approved is bool
          && (!('wantsDev' in request.resource.data) || request.resource.data.wantsDev is bool)
          && (!('isDeveloper' in request.resource.data) || request.resource.data.isDeveloper is bool)
          && (!('admin' in request.resource.data) || request.resource.data.admin is bool))
      );

      allow delete: if false;

      // Recovery email, split out from the parent doc specifically so it's never exposed by the
      // parent's own public `allow read: if true`. Only the owner and the admin can ever read or
      // write it. auth.js's updateRecoveryEmail() targets this doc (fixed id 'contact') instead of
      // the parent profile now.
      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid
          && docId == 'contact'
          && request.resource.data.keys().hasOnly(['recoveryEmail'])
          && (!('recoveryEmail' in request.resource.data) || request.resource.data.recoveryEmail is string);
        allow delete: if request.auth != null && request.auth.uid == uid && docId == 'contact';
      }
    }

    match /scores/{scoreId} {
      // A score is only publicly visible once its submitter's account is approved. IMPORTANT:
      // Firestore security rules can VALIDATE a write, but cannot reliably FILTER a list()/query
      // result based on a get() to a different document -- a get()-based check here only works
      // for a single-document read, not for the actual board queries every game page runs. (An
      // earlier version of this rule assumed otherwise; verified wrong in production -- an
      // unapproved account's score was publicly visible on the real board query.) So `approved`
      // is denormalized directly onto the score doc itself at write time (see hasValidIdentity),
      // kept in sync by admin/index.html's approve/revoke action batch-updating every score by
      // that uid, and the read rule below is a plain field check -- provably filterable by
      // Firestore for list() queries, which is exactly why every game's board query itself also
      // has an explicit `.where('approved','==',true)`; the rule is the backstop, the query is
      // what actually keeps a non-compliant doc from ever being fetched. A pre-sign-in-required
      // score with no uid at all (from before that policy) has no submitter to gate on, so it
      // stays visible as-is (backfilled with approved:true -- see backfill-score-approved.js).
      // Deliberately does NOT add an "owner can always read their own" clause here even though
      // that seems like an obvious addition (account/index.html's "Your Submissions" list wanting
      // to show a still-pending account's own scores back to them) -- mixing a
      // request.auth-uid-vs-resource.data-field comparison into this OR breaks the "provably
      // filterable" property list() queries need: confirmed in production, a plain
      // .where('uid','==',someUid).get() (no other filter) started throwing a flat
      // permission-denied for the WHOLE query the moment that clause existed, for EVERY caller
      // (not just cross-user queries) -- Firestore's query-safety check is evaluated statically
      // against the rule text as a whole, not per specific query, so one unprovable OR-branch
      // poisons list() access to the entire collection. isAdmin() does NOT have this problem --
      // it depends only on request.auth, never on resource.data, so it stays a fixed true/false
      // for a given caller across every document, which Firestore CAN prove safe (this is the
      // same reason every other collection's isAdmin()-gated read/write in this file works fine
      // for queries). That's what makes admin/index.html's approve/revoke fan-out
      // (.where('uid','==',uid).get(), no approved filter, needs to see NOT-yet-approved docs to
      // flip them) possible at all. "Your Submissions" still can't show a still-pending score --
      // the account page isn't the admin -- so its own query adds an explicit
      // .where('approved','==',true) instead, same pattern as every board query, trading
      // "shows only approved" for "doesn't error."
      allow read: if !('uid' in resource.data) || resource.data.approved == true || isAdmin();

      // A score's uid/username pair is required (anonymous QR submission was retired) and can't
      // be spoofed: uid must match the actual signed-in caller, and username must equal the
      // caller's CURRENT users/{uid}.username -- it's a denormalized copy shown on every board as
      // a profile link, and it used to be shape-checked only, so anyone could put another
      // player's @handle on their own scores. Every page writes NGPC_AUTH.currentUser.username,
      // which auth.js loads from that same field (audited 2026-10-01: all 181 existing scores
      // matched exactly). A score written before a later rename keeps its old name (rules only
      // check writes). `approved` MUST likewise match users/{uid}.approved at write time. Both
      // read the same users doc, which Firestore counts as one get() per request -- fine because
      // it's a single-document read on a write, not a list() query.
      function hasValidIdentity(d) {
        return ('uid' in d) && ('username' in d) && ('approved' in d)
          && request.auth != null && request.auth.uid == d.uid
          && d.username is string && d.username.matches('^[A-Za-z0-9_]{3,16}$')
          && d.approved is bool
          && d.approved == get(/databases/$(database)/documents/users/$(d.uid)).data.approved
          && d.username == get(/databases/$(database)/documents/users/$(d.uid)).data.username;
      }

      // Matches the object lb/index.html's writeScore() builds (game, initials, score, weight,
      // rolls, source, submittedAt, plus required uid/username from auth.js). source is 'qr' for
      // a real camera/photo scan (incl. the on-device QR's own deep link) or 'capture' for the
      // in-browser player's Screen Capture API flow (play/<game>/index.html's captureAndSubmit(),
      // which hands off via a "?src=capture" query param) -- see admin/game/index.html's
      // scan-source breakdown, the only place this distinction is surfaced.
      function isBowlingScore(d) {
        return d.game == 'BW'
          && d.keys().hasOnly(['game', 'initials', 'score', 'weight', 'rolls', 'source', 'submittedAt', 'uid', 'username', 'approved',
                               'version', 'avg10', 'avgGames', 'verified'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 300
          && d.weight is int && d.weight >= 1 && d.weight <= 99
          // optional, v3 QR codes only (bowling_109+): the cart's own average x10 and games in it,
          // for the tournament handicap -- see Bowling/TOURNAMENT_SITE_SPEC.md
          && (!('version' in d) || (d.version is int && d.version == 3))
          && (!('avg10' in d) || (d.avg10 is int && d.avg10 >= 0 && d.avg10 <= 3000))
          && (!('avgGames' in d) || (d.avgGames is int && d.avgGames >= 0 && d.avgGames <= 999))
          && (!('verified' in d) || d.verified is bool)
          && d.rolls is list && d.rolls.size() >= 12 && d.rolls.size() <= 21
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Matches tetris/index.html's writeScore() call (game, initials, score, lines, level,
      // source, submittedAt, plus required uid/username) -- field widths mirror the on-device QR
      // payload's own fixed-width digit fields (8-digit score, 5-digit lines, 3-digit level; see
      // Tetris's main.c qr_build_payload()).
      function isTetrisScore(d) {
        return d.game == 'TT'
          && d.keys().hasOnly(['game', 'initials', 'score', 'lines', 'level', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999999
          && d.lines is int && d.lines >= 0 && d.lines <= 99999
          && d.level is int && d.level >= 0 && d.level <= 999
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Yahtzee: game, initials, score, categoryScores (13 ints), source, submittedAt,
      // required uid/username.
      function isYahtzeeScore(d) {
        return d.game == 'YZ'
          && d.keys().hasOnly(['game', 'initials', 'score', 'categoryScores', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999
          && d.categoryScores is list && d.categoryScores.size() == 13
          && d.categoryScores[0] is int && d.categoryScores[0] >= 0 && d.categoryScores[0] <= 30  // ones-sixes
          && d.categoryScores[1] is int && d.categoryScores[1] >= 0 && d.categoryScores[1] <= 30
          && d.categoryScores[2] is int && d.categoryScores[2] >= 0 && d.categoryScores[2] <= 30
          && d.categoryScores[3] is int && d.categoryScores[3] >= 0 && d.categoryScores[3] <= 30
          && d.categoryScores[4] is int && d.categoryScores[4] >= 0 && d.categoryScores[4] <= 30
          && d.categoryScores[5] is int && d.categoryScores[5] >= 0 && d.categoryScores[5] <= 30
          && d.categoryScores[6] is int && d.categoryScores[6] >= 0 && d.categoryScores[6] <= 30  // 3-kind through chance
          && d.categoryScores[7] is int && d.categoryScores[7] >= 0 && d.categoryScores[7] <= 30
          && d.categoryScores[8] is int && d.categoryScores[8] >= 0 && d.categoryScores[8] <= 25  // full house
          && d.categoryScores[9] is int && d.categoryScores[9] >= 0 && d.categoryScores[9] <= 30  // small straight
          && d.categoryScores[10] is int && d.categoryScores[10] >= 0 && d.categoryScores[10] <= 40  // large straight
          && d.categoryScores[11] is int && d.categoryScores[11] >= 0 && d.categoryScores[11] <= 50  // yahtzee
          && d.categoryScores[12] is int && d.categoryScores[12] >= 0 && d.categoryScores[12] <= 30  // chance
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Farkle: game, initials, score, rounds, opened, farkles, resultChar, resultDisplay,
      // source, submittedAt, required uid/username.
      function isFarkleScore(d) {
        return d.game == 'FK'
          && d.keys().hasOnly(['game', 'initials', 'score', 'rounds', 'opened', 'farkles', 'resultChar', 'resultDisplay', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.rounds is int && d.rounds >= 0 && d.rounds <= 999
          && d.opened is int && d.opened >= 0 && d.opened <= 999
          && d.farkles is int && d.farkles >= 0 && d.farkles <= 999
          && d.resultChar is string && d.resultChar.matches('^[1WLD]$')
          && d.resultDisplay is string && d.resultDisplay.matches('^(SOLO|WIN|LOSS|DRAW)$')
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // 2048: game, initials, score, moves, source, submittedAt, required uid/username -- field
      // widths mirror the on-device QR payload's own fixed-width digit fields (5-digit score,
      // 4-digit moves; see 2048's main.c qr_build_payload()).
      function is2048Score(d) {
        return d.game == '2K'
          && d.keys().hasOnly(['game', 'initials', 'score', 'moves', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.moves is int && d.moves >= 0 && d.moves <= 9999
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Over Rev: game, initials (1-8 chars, not 3 -- this game's QR carries a free-typed name,
      // not fixed initials), rules/course/car/tune/mode/difficulty/transmission/ticks/won/
      // localRecord/event/sequence/raw, source, submittedAt, required uid/username. Sorted
      // ascending by ticks on the leaderboard (lower is better), unlike every other game here.
      // Shape/bounds only -- does not re-verify the OV1 Base32/CRC24 encoding itself; see
      // overrev-leaderboard-kit/README.md for why that's a client-side-only guarantee.
      function isOverRevScore(d) {
        return d.game == 'OV'
          && d.keys().hasOnly(['game', 'initials', 'rules', 'course', 'car', 'tune', 'mode', 'difficulty', 'transmission', 'ticks', 'won', 'localRecord', 'event', 'sequence', 'raw', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z0-9]{1,8}$')
          && d.rules is int && d.rules == 1
          && d.course is int && d.course >= 0 && d.course < 16
          && d.car is int && d.car >= 0 && d.car < 9
          && d.tune is int && d.tune >= 0 && d.tune <= 255
          && d.mode is int && d.mode == 1
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 3
          && d.transmission is string && d.transmission in ['AT', 'MT']
          && d.ticks is int && d.ticks >= 1 && d.ticks <= 65535
          && d.won is bool && d.localRecord is bool
          && d.event is int && d.event == 0
          && d.sequence is int && d.sequence >= 0 && d.sequence <= 65535
          && d.raw is string && d.raw.matches('^OV1:[A-Z0-9]{1,8}:[A-Z2-7]{24}$')
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Gardenia: game, mode (1 Picnic/2 Gardener/3 Landscaper), initials, score,
      // startLevel/levelReached (info only, not re-derived or bounds-checked against each other),
      // source, submittedAt, required uid/username. Field widths mirror the author's own QR
      // spec's fixed-width digit fields (5-digit score, 2-digit level fields). Sorted descending
      // by score, scoped to one mode at a time -- see gd/index.html's own board query.
      function isGardeniaScore(d) {
        return d.game == 'GD'
          && d.keys().hasOnly(['game', 'mode', 'initials', 'score', 'startLevel', 'levelReached', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.mode is int && d.mode >= 1 && d.mode <= 3
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999
          && d.startLevel is int && d.startLevel >= 0 && d.startLevel <= 99
          && d.levelReached is int && d.levelReached >= 0 && d.levelReached <= 99
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Sudoku: game, difficulty (E/M/H), time (seconds, 1-5 digits per the submission's own
      // spec), misses (3-digit zero-padded mistake count), source, submittedAt, required
      // uid/username -- no initials field, unlike every other game here; Sudoku's own high-score
      // flow doesn't collect device-typed initials. Sorted ascending by time (faster wins),
      // scoped to one difficulty at a time -- approved via /dev/submit/ -> admin/index.html's
      // submission review, same path any future developer submission goes through.
      function isSudokuScore(d) {
        return d.game == 'SD'
          && d.keys().hasOnly(['game', 'initials', 'difficulty', 'time', 'misses', 'seed', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          // Added after the original spec shipped -- an un-updated cartridge's QR has no
          // initials at all, so this stays optional the same way `seed` does below (a pre-update
          // score already on the board keeps working; see sd/index.html's own `data.initials ||
          // '???'` fallback on the board row).
          && (!('initials' in d) || (d.initials is string && d.initials.matches('^[A-Z0-9 .]{3}$')))
          && d.difficulty is string && d.difficulty in ['E', 'M', 'H']
          && d.time is int && d.time >= 0 && d.time <= 99999
          && d.misses is int && d.misses >= 0 && d.misses <= 999
          // Optional -- added after the original spec shipped, so an un-updated cartridge's QR
          // (no SEED- token at all) still parses and submits fine without it.
          && (!('seed' in d) || (d.seed is int && d.seed >= 0 && d.seed <= 65535))
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Furry: game, initials, and 15 numeric run-stat fields, per the developer's own submitted
      // spec (fixed-width, URL-prefixed same as every other game here). totalScore is sent
      // pre-computed by the console and used as-is, never recomputed (its own formula depends on
      // gems still in the HUD at run end, which isn't transmitted) -- see fu/index.html's own
      // renderScorecardHTML comment. The six "deaths by X" fields sum to totalDeaths, per the
      // developer's own note; verified against all three of their real example payloads.
      function isFurryScore(d) {
        return d.game == 'FU'
          && d.keys().hasOnly(['game', 'initials', 'startWorld', 'levelReached', 'gameCompleted', 'playTimeInSeconds', 'gemsCollectedTotal', 'totalDeaths', 'livesLeft', 'enemiesShot', 'bombsThatExplodedOnFurry', 'deathsByEnemies', 'deathsByBombs', 'deathsBySpikes', 'deathsByLavaAndAcid', 'deathsByPiranhas', 'deathsByFallingIntoTheAbyss', 'totalScore', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.startWorld is int && d.startWorld >= 0 && d.startWorld <= 9
          && d.levelReached is int && d.levelReached >= 0 && d.levelReached <= 99
          && d.gameCompleted is int && d.gameCompleted >= 0 && d.gameCompleted <= 9
          && d.playTimeInSeconds is int && d.playTimeInSeconds >= 0 && d.playTimeInSeconds <= 99999
          && d.gemsCollectedTotal is int && d.gemsCollectedTotal >= 0 && d.gemsCollectedTotal <= 99999
          && d.totalDeaths is int && d.totalDeaths >= 0 && d.totalDeaths <= 999
          && d.livesLeft is int && d.livesLeft >= 0 && d.livesLeft <= 9
          && d.enemiesShot is int && d.enemiesShot >= 0 && d.enemiesShot <= 999
          && d.bombsThatExplodedOnFurry is int && d.bombsThatExplodedOnFurry >= 0 && d.bombsThatExplodedOnFurry <= 999
          && d.deathsByEnemies is int && d.deathsByEnemies >= 0 && d.deathsByEnemies <= 999
          && d.deathsByBombs is int && d.deathsByBombs >= 0 && d.deathsByBombs <= 999
          && d.deathsBySpikes is int && d.deathsBySpikes >= 0 && d.deathsBySpikes <= 999
          && d.deathsByLavaAndAcid is int && d.deathsByLavaAndAcid >= 0 && d.deathsByLavaAndAcid <= 999
          && d.deathsByPiranhas is int && d.deathsByPiranhas >= 0 && d.deathsByPiranhas <= 999
          && d.deathsByFallingIntoTheAbyss is int && d.deathsByFallingIntoTheAbyss >= 0 && d.deathsByFallingIntoTheAbyss <= 999
          && d.totalScore is int && d.totalScore >= 0 && d.totalScore <= 99999
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Xenon 2: game, initials, score, money, checkpoint, livesLeft, source, submittedAt,
      // required uid/username. Third-party (firmware not in this workspace) -- shape/bounds only,
      // per the developer's own submitted spec (fixed-width, no delimiters, no URL: the raw QR
      // text is bare "XN" + fields, unlike every other game's URL-prefixed payload -- see
      // xn/index.html's own parser comment). Score is sent as a final total, not reconstructed
      // from raw inputs (a scrolling shooter has no short list of replayable events the way
      // Bowling's rolls or Yahtzee's categories do, per the submission's own scorecardFormula);
      // checkpoint/livesLeft/money are plausibility anchors and detail-view fields, not derived
      // from score or from each other.
      function isXenon2Score(d) {
        return d.game == 'XN'
          && d.keys().hasOnly(['game', 'initials', 'score', 'money', 'checkpoint', 'livesLeft', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999999
          && d.money is int && d.money >= 0 && d.money <= 65535
          && d.checkpoint is int && d.checkpoint >= 0 && d.checkpoint <= 7
          && d.livesLeft is int && d.livesLeft >= 0 && d.livesLeft <= 9
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Breakout: game, initials, score, levelStart, levelFinish, difficulty, secretUsed, source,
      // submittedAt, required uid/username. Generated by NGPC-Admin-Scripts/scaffold-game.js from
      // gameSubmissions/P2KzUP4pzwOQG1dEFpmO's own payload spec (every field fixed-width, no
      // manual TODOs left), then reviewed by hand -- bounds widened from the generator's plain
      // "10^width - 1" guess only where the submission's own notes said otherwise.
      function isBreakoutScore(d) {
        return d.game == 'BK'
          && d.keys().hasOnly(['game', 'initials', 'score', 'levelStart', 'levelFinish', 'difficulty', 'secretUsed', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 99999
          && d.levelStart is int && d.levelStart >= 0 && d.levelStart <= 9
          && d.levelFinish is int && d.levelFinish >= 0 && d.levelFinish <= 9
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 9
          && d.secretUsed is int && d.secretUsed >= 0 && d.secretUsed <= 9
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Minesweeper: game, initials, difficulty, time, source, submittedAt, required
      // uid/username. Generated by NGPC-Admin-Scripts/scaffold-game.js from
      // gameSubmissions/9iAElrQRLjCJt4QV7slB's own payload spec (every field fixed-width, no
      // manual TODOs left) -- bounds are the generator's plain "10^width - 1" guess, not yet
      // hand-tightened against the developer's real difficulty enum/time range.
      function isMinesweeperScore(d) {
        return d.game == 'MS'
          && d.keys().hasOnly(['game', 'initials', 'difficulty', 'time', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 9
          && d.time is int && d.time >= 0 && d.time <= 9999
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Don't Die Mr Robot: game, difficulty (1-3, Easy/Fair/Hard -- scores only comparable within
      // one difficulty, see ddmr/index.html's own mode toggle), initials, score, source,
      // submittedAt, required uid/username. The submission's own QR also carries a 4-hex CRC16
      // checksum (over difficulty+initials+score, poly 0x1021, init 0xFFFF) -- verified client-side
      // then discarded per the developer's own notes ("CRC field to be discarded"), so it's
      // deliberately NOT in this doc shape at all. score bound is 65535 per the submission's own
      // explicit "0-65535" spec, tighter than the 5-digit field width (99999) would otherwise imply.
      // Initials allow [A-Z0-9 .] (not just letters) -- the submission's own format note and this
      // developer's other games' example payloads show device initials can include a digit or a
      // trailing space/period, not just letters.
      function isDonTDieMrRobotScore(d) {
        return d.game == 'DDMR'
          && d.keys().hasOnly(['game', 'difficulty', 'initials', 'score', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 3
          && d.initials is string && d.initials.matches('^[A-Z0-9 .]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Fruity Pals' Revenge: game, mode (0-3, Training/Arcade/Pure/Chillout -- scores only
      // comparable within one mode, see rvng/index.html's own mode toggle), initials, score,
      // source, submittedAt, required uid/username. The submission's own QR also carries a 4-hex
      // CRC16 checksum (over mode+initials+score, poly 0x1021, init 0xFFFF) -- verified
      // client-side then discarded per the same convention as Gardenia/Don't Die Mr Robot, so it's
      // deliberately NOT in this doc shape at all. score bound is 65535 per the submission's own
      // explicit "0-65535" spec, tighter than the 5-digit field width (99999) would otherwise imply.
      // Initials allow [A-Z0-9 .] (not just letters) -- the submission's own format note and
      // example payloads (a letter+digit+space combination) show device initials aren't
      // letters-only.
      function isFruityPalsRevengeScore(d) {
        return d.game == 'RVNG'
          && d.keys().hasOnly(['game', 'mode', 'initials', 'score', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.mode is int && d.mode >= 0 && d.mode <= 3
          && d.initials is string && d.initials.matches('^[A-Z0-9 .]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Horatio Goes Snowboarding: game, mode (0=Adventure/1=Endless), difficulty (0-3, only
      // meaningful in Adventure -- Endless always sends 00 as a placeholder), initials, score,
      // source, submittedAt, required uid/username. Scores only comparable within one
      // mode+difficulty group, see hgs/index.html's own 5-group toggle. The submission's own QR
      // also carries a 4-hex CRC16 checksum (over mode+difficulty+initials+score, poly 0x1021,
      // init 0xFFFF) -- verified client-side then discarded per the same convention as this
      // developer's other games (Gardenia/Don't Die Mr Robot/Fruity Pals' Revenge), so it's
      // deliberately NOT in this doc shape at all. score bound is 65535 per the submission's own
      // explicit "0-65535" spec, tighter than the 5-digit field width (99999) would otherwise imply.
      // Initials allow [A-Z0-9 .] (not just letters), same reasoning as this developer's other games.
      function isHoratioGoesSnowboardingScore(d) {
        return d.game == 'HGS'
          && d.keys().hasOnly(['game', 'mode', 'difficulty', 'initials', 'score', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.mode is int && d.mode >= 0 && d.mode <= 1
          && d.difficulty is int && d.difficulty >= 0 && d.difficulty <= 3
          && d.initials is string && d.initials.matches('^[A-Z0-9 .]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 65535
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Carcassonne: game, initials, the reconstructed final score plus its 4 category
      // subtotals, tileCount, riverEnabled, the two shuffle seeds, and `tiles` -- a JSON-encoded
      // array of [shapeId,rotation,x,y] tuples for the leaderboard's own board-recreation flyout
      // (NOT the raw multi-QR-code wire fields like codeKind/moreFlag/boardData -- those are pure
      // scan-transport artifacts the client already resolves into this shape before writing, since
      // one score doc can be assembled from more than one scanned QR code). score/road/city/
      // cloister/farm bounds are generous headroom over realistic play, not tight spec numbers (see
      // src/game/carc_qr_payload.c in the Carcassonne2 NGPC project for the real wire format this
      // is decoded from). `tiles` is capped at 4000 chars -- a full ~85-tile game's JSON encoding
      // is comfortably under 1500.
      function isCarcassonneScore(d) {
        return d.game == 'CA'
          && d.keys().hasOnly(['game', 'initials', 'score', 'road', 'city', 'cloister', 'farm', 'tileCount', 'riverEnabled', 'deckSeed', 'riverSeed', 'tiles', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.score is int && d.score >= 0 && d.score <= 9999
          && d.road is int && d.road >= 0 && d.road <= 999
          && d.city is int && d.city >= 0 && d.city <= 999
          && d.cloister is int && d.cloister >= 0 && d.cloister <= 999
          && d.farm is int && d.farm >= 0 && d.farm <= 999
          && d.tileCount is int && d.tileCount >= 0 && d.tileCount <= 99
          && d.riverEnabled is bool
          && d.deckSeed is int && d.deckSeed >= 0 && d.deckSeed <= 65535
          && d.riverSeed is int && d.riverSeed >= 0 && d.riverSeed <= 65535
          && d.tiles is string && d.tiles.size() <= 4000
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Sokoban: game, formatVersion, initials, result, levelsSolved, totalMoves, totalPushes,
      // playTime, overPar, overParTotal, stars, source, submittedAt, required uid/username -- the
      // exact record sk/index.html's confirm handler writes. overPar is the cartridge's own 30-char
      // per-level string (0-9A-Z = moves over par, '-' = unsolved); overParTotal/stars are derived
      // from it client-side and only range-checked here (each solved level is 0-35 over par and
      // 1-3 stars). The QR's base-36 checksum is verified client-side then discarded, same as
      // DDMR/RVNG/HGS's CRC, so it's NOT in this doc shape. formatVersion and result are locked to
      // '1' (format v1 = the current 30-level par table; '1' = solo) -- a new level set or a VS
      // Link mode needs this republished, not just a page update. See Sokoban/GAME_SPEC.md.
      // True if Sokoban score n ranks strictly above o -- the board's order: more stars,
      // then fewer moves over par, then fewer total moves. Used to make an owner's update of their
      // one SK entry keep-best on the server, not just in sk/index.html.
      function skRanksBetter(n, o) {
        return n.stars > o.stars
          || (n.stars == o.stars
            && (n.overParTotal < o.overParTotal
              || (n.overParTotal == o.overParTotal && n.totalMoves < o.totalMoves)));
      }
      function isSokobanScore(d) {
        return d.game == 'SK'
          && d.keys().hasOnly(['game', 'formatVersion', 'initials', 'result', 'levelsSolved', 'totalMoves', 'totalPushes', 'playTime', 'overPar', 'overParTotal', 'stars', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.formatVersion is string && d.formatVersion == '1'
          && d.initials is string && d.initials.matches('^[A-Z]{3}$')
          && d.result is string && d.result == '1'
          && d.levelsSolved is int && d.levelsSolved >= 1 && d.levelsSolved <= 30
          && d.totalMoves is int && d.totalMoves >= 0 && d.totalMoves <= 99999
          && d.totalPushes is int && d.totalPushes >= 0 && d.totalPushes <= 99999
          && d.playTime is int && d.playTime >= 0 && d.playTime <= 99999
          && d.overPar is string && d.overPar.matches('^[0-9A-Z-]{30}$')
          && d.overParTotal is int && d.overParTotal >= 0 && d.overParTotal <= d.levelsSolved * 35
          && d.stars is int && d.stars >= d.levelsSolved && d.stars <= d.levelsSolved * 3
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // RED DRAGON (Legend of the Red Dragon clone): game, formatVersion, heroId, initials (the
      // hero's name, 1-8 letters), cls, level, experience, dragonKills, daysPlayed, status, source,
      // submittedAt, required uid/username -- the exact record rd/index.html's confirm handler
      // writes. The board is a live warrior list, not a best-score board: each hero keeps ONE doc
      // at scores/RD_<uid>_<heroId> that its owner replaces with any upload from the same or a
      // later cartridge day (rdIsNewer) -- experience may legitimately go DOWN (death, dragon
      // reset). The QR's base-36 checksum is verified client-side then discarded. formatVersion is
      // locked to '1'. See RedDragon/GAME_SPEC.md + submission-template.json.
      function rdIsNewer(n, o) {
        return n.heroId == o.heroId && n.daysPlayed >= o.daysPlayed;
      }
      function isRedDragonScore(d) {
        return d.game == 'RD'
          && d.keys().hasOnly(['game', 'formatVersion', 'heroId', 'initials', 'cls', 'level', 'experience', 'dragonKills', 'daysPlayed', 'status', 'source', 'submittedAt', 'uid', 'username', 'approved'])
          && d.formatVersion is string && d.formatVersion == '1'
          && d.heroId is string && d.heroId.matches('^[0-9A-Z]{4}$')
          && d.initials is string && d.initials.matches('^[A-Z]{1,8}$')
          && d.cls is string && d.cls in ['K', 'M', 'T']
          && d.level is int && d.level >= 1 && d.level <= 12
          && d.experience is int && d.experience >= 0 && d.experience <= 2176782335
          && d.dragonKills is int && d.dragonKills >= 0 && d.dragonKills <= 1295
          && d.daysPlayed is int && d.daysPlayed >= 1 && d.daysPlayed <= 46655
          && d.status is string && d.status in ['A', 'D']
          && d.source is string && d.source in ['qr', 'capture']
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && hasValidIdentity(d);
      }

      // Sokoban keeps ONE entry per player at the fixed id scores/SK_<uid>, so the id itself is
      // tied to the caller: an SK score may only be created at SK_<own uid>, and no other game's
      // score may take an SK_ id (otherwise anyone could squat SK_<victim> and permanently block
      // that player, since only the doc's owner may update or delete it). Auto-ids never contain
      // '_', so every other game's add() is unaffected.
      allow create: if (isBowlingScore(request.resource.data) || isTetrisScore(request.resource.data) || isYahtzeeScore(request.resource.data) || isFarkleScore(request.resource.data) || is2048Score(request.resource.data) || isOverRevScore(request.resource.data) || isGardeniaScore(request.resource.data) || isSudokuScore(request.resource.data) || isXenon2Score(request.resource.data) || isBreakoutScore(request.resource.data) || isMinesweeperScore(request.resource.data) || isDonTDieMrRobotScore(request.resource.data) || isFruityPalsRevengeScore(request.resource.data) || isHoratioGoesSnowboardingScore(request.resource.data) || isFurryScore(request.resource.data) || isCarcassonneScore(request.resource.data)
          || (isSokobanScore(request.resource.data) && scoreId == 'SK_' + request.auth.uid)
          || (isRedDragonScore(request.resource.data) && scoreId == 'RD_' + request.auth.uid + '_' + request.resource.data.heroId))
        && !(scoreId.matches('^SK_.*') && request.resource.data.game != 'SK')
        && !(scoreId.matches('^RD_.*') && request.resource.data.game != 'RD');

      // Only the admin, and only the `approved` field -- fans out an account approve/revoke
      // (admin/index.html) to every score that account already submitted, so a toggle's effect on
      // board visibility is immediate for past scores too, not just ones submitted from then on.
      // Second branch: Sokoban keeps ONE progressive entry per player (scores/SK_<uid>), so its
      // owner may replace it with another fully valid Sokoban score that RANKS STRICTLY BETTER
      // (skRanksBetter) -- keep-best is enforced here, so a worse code (reset or different cart),
      // a rescan, or a stale cached page can never clobber a best. isSokobanScore() re-checks every
      // field plus hasValidIdentity (uid == caller, approved == users/{uid}.approved).
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
          && request.resource.data.approved is bool)
        || (request.auth != null
          && scoreId == 'SK_' + request.auth.uid
          && resource.data.game == 'SK'
          && resource.data.uid == request.auth.uid
          && isSokobanScore(request.resource.data)
          && skRanksBetter(request.resource.data, resource.data))
        // Third branch: RED DRAGON keeps ONE live entry per hero (scores/RD_<uid>_<heroId>); its
        // owner may replace it with any valid upload of the SAME hero from the same or a later
        // cartridge day (rdIsNewer), so a stale code can't roll the list back.
        || (request.auth != null
          && scoreId == 'RD_' + request.auth.uid + '_' + resource.data.heroId
          && resource.data.game == 'RD'
          && resource.data.uid == request.auth.uid
          && isRedDragonScore(request.resource.data)
          && rdIsNewer(request.resource.data, resource.data));
      // A signed-in user can delete their own score (account page's "Your Submissions" list) --
      // anonymous QR submissions have no uid at all, so resource.data.uid == request.auth.uid is
      // false for them (never true against a signed-in caller's uid), and they stay undeletable
      // by anyone except the admin. isAdmin() also covers admin/index.html's own site-wide
      // "All Submissions" panel, which needs to delete any score regardless of submitter.
      allow delete: if request.auth != null
        && (('uid' in resource.data) && resource.data.uid == request.auth.uid || isAdmin());
    }

    // games/{slug} is the main page's authoritative tile data (name, dev status, ROM location,
    // last-updated) -- index.html renders its grid FROM this collection instead of hardcoded
    // HTML, so a game's own assigned developer can update their dev status and ROM without
    // ever touching a file in this repo. Split-permission by field, same pattern as users/{uid}:
    // the admin owns pure identity fields (name/code/leaderboardPath/addedAt/developerUid --
    // adding a game or reassigning its developer is an admin action), while the assigned
    // developer can touch the fields describing their own build, INCLUDING the game's art
    // (titleImage/extraScreenshot1Path/extraScreenshot2Path -- see admin/game/index.html's own
    // art-upload panel) -- a developer replacing their own game's screenshots is the same trust
    // level as them uploading their own ROM below, not an identity change.
    match /games/{slug} {
      allow read: if true;

      function isAssignedDev(d) {
        return request.auth != null && ('developerUid' in d) && d.developerUid == request.auth.uid;
      }

      allow create: if isAdmin();
      // 'coming-soon' is a devStatus a game's own developer can opt into at their own discretion
      // (see admin/game/index.html's status buttons), and is also every accepted submission's own
      // starting status. It shares index.html's single top-left corner ribbon with NEW/UPDATED
      // (mutually exclusive, coming-soon wins while set -- see buildTile()). newUntil is included
      // here alongside devStatus because leaving coming-soon resets it to a fresh 30-day window
      // (that's the moment NEW should actually start counting down, not back at approval time) --
      // same trust level already granted for updatedUntil below, only ever a cosmetic ribbon
      // either way.
      allow update: if (request.auth != null && (
          isAdmin()
          // description/siteUrl -- free-text blurb + a link back to the developer's own site,
          // shown on that game's leaderboard page directly under its screenshots (see
          // bk/index.html's own .game-desc/.game-site, or NGPC-Admin-Scripts/scaffold-game.js's
          // template for a newly-scaffolded game). Same trust level as the art fields below: a
          // developer describing their own game is not an identity change. siteUrl is
          // scheme-restricted to http(s) specifically so this field can never hold a
          // javascript:/data: URI that a leaderboard page would otherwise render straight into an
          // href. visibility -- the developer's own on/off switch for their game's tile on the
          // main page: 'active' (normal), 'inactive' (tile stays listed but unclickable, same
          // treatment as a coming-soon tile), or 'hidden' (index.html's renderGrid() skips it
          // entirely) -- same trust level as devStatus itself, which already controls that tile's
          // banner. Replaces the older boolean `active` field (still readable on old docs as a
          // fallback -- see index.html's own loadGames()/buildTile() -- but no longer written).
          // titleImage*/extraScreenshot*UpdatedAt are the companion timestamps
          // admin/game/index.html stamps alongside each art upload, purely informational (so a
          // developer can see how stale their own screenshots are) -- never trusted for anything
          // else. emulator -- which web-player backend play/<slug>/ mounts, EmulatorJS (default/
          // missing) or NgpCraft (github.com/Tixul/NgpCraft_web_emulator) -- see play/webplayer.js's
          // own header comment; purely a UI choice, same trust level as devStatus. version -- a
          // free-text build/version string (e.g. "v1.2"), shown on this game's own leaderboard
          // page next to its title, and optionally (showVersionOnTile) right-justified inline
          // with the game name on the homepage tile too -- see index.html's buildTile().
          // previewTesters -- an admin- or the assigned-developer-curated list of OTHER accounts'
          // uids allowed to see and play this game's leaderboard/play page while it's still
          // devStatus 'coming-soon', without granting them any ability to edit the game itself
          // (see auth.js's canPreviewGame(), which every access-gated leaderboard/play page's
          // isAuthorizedViewer() checks alongside isGameManager). Capped at 20 entries -- this is
          // a short early-access list, not a general permissions system.
          || (isAssignedDev(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devStatus', 'romPath', 'romFileName', 'romUpdatedAt', 'updatedUntil', 'newUntil', 'titleImage', 'extraScreenshot1Path', 'extraScreenshot2Path', 'titleImageUpdatedAt', 'extraScreenshot1UpdatedAt', 'extraScreenshot2UpdatedAt', 'description', 'siteUrl', 'visibility', 'emulator', 'version', 'showVersionOnTile', 'previewTesters'])
              && request.resource.data.devStatus in ['coming-soon', 'dev', 'beta', 'final']
              && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 300))
              && (!('siteUrl' in request.resource.data) || (request.resource.data.siteUrl is string && (request.resource.data.siteUrl == '' || request.resource.data.siteUrl.matches('^https?://.+'))))
              && (!('visibility' in request.resource.data) || request.resource.data.visibility in ['active', 'inactive', 'hidden'])
              && (!('emulator' in request.resource.data) || request.resource.data.emulator in ['emulatorjs', 'ngpcraft'])
              && (!('version' in request.resource.data) || (request.resource.data.version is string && request.resource.data.version.size() <= 20))
              && (!('showVersionOnTile' in request.resource.data) || request.resource.data.showVersionOnTile is bool)
              && (!('previewTesters' in request.resource.data) || (request.resource.data.previewTesters is list && request.resource.data.previewTesters.size() <= 20))
              && (!('titleImageUpdatedAt' in request.resource.data) || request.resource.data.titleImageUpdatedAt is int)
              && (!('extraScreenshot1UpdatedAt' in request.resource.data) || request.resource.data.extraScreenshot1UpdatedAt is int)
              && (!('extraScreenshot2UpdatedAt' in request.resource.data) || request.resource.data.extraScreenshot2UpdatedAt is int))
        ))
        // romDownloads -- a public, anonymous-writable +1 counter (same shape as meta/siteStats'
        // pageViews above), bumped by every leaderboard page's rom-link click handler. No sign-in
        // requirement, same as a plain download link never required one; still can't be set to an
        // arbitrary/negative value or touch any other field.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['romDownloads'])
            && request.resource.data.romDownloads == (('romDownloads' in resource.data) ? resource.data.romDownloads : 0) + 1);
      allow delete: if isAdmin();
    }

    // gameSubmissions/{id} -- a new-game proposal from a prospective developer: ROM + title
    // screenshot, plus up to two optional extra screenshots/GIFs for that game's own leaderboard
    // page later (Storage paths, see storage.rules' submissions/{uid}/{subId}/ block) plus a
    // structured payload spec (field layout, sort field, scorecard formula, example payloads --
    // the same shape dev/submit/submission-template.json / NGPC-QR-SDK/SUBMISSION_TEMPLATE.md
    // asks a developer to fill out by hand, just captured as data here instead of chased down
    // over chat). Private to the submitter and
    // the admin -- an unreviewed submission was never meant to be public. Approving one is still
    // a manual admin action elsewhere (creating the real games/{slug} doc, and -- outside this
    // rules file entirely -- hand-building that game's own leaderboard page and score-shape
    // validator, the same way every game here always has been); this collection only removes the
    // "chase the developer for details" step, not that build step.
    match /gameSubmissions/{id} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.submitterUid || isAdmin());

      // Gated behind users/{uid}.isDeveloper -- the account-level yes/no the admin grants from
      // the Players table, not tied to any specific game (see users/{uid}'s own comment). One
      // get() here is fine; it's a create, not a list() query.
      allow create: if request.auth != null
        && request.resource.data.submitterUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDeveloper', false) == true
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
             'submitterUid', 'submitterUsername', 'proposedName', 'proposedCode',
             'romPath', 'romFileName', 'screenshotPath',
             'extraScreenshot1Path', 'extraScreenshot2Path',
             'payloadFields', 'totalLength',
             'sortField', 'sortDirection', 'scorecardFormula', 'examplePayloads', 'otherNotes',
             'status', 'submittedAt', 'reviewedAt', 'reviewNote'
           ])
        && request.resource.data.proposedName is string
        && request.resource.data.proposedCode is string && request.resource.data.proposedCode.matches('^[A-Z0-9]{2,6}$')
        && request.resource.data.submittedAt is int
        // The scaffold bakes this into a game page's public "Created by" line, so it must be the
        // submitter's real (permanent) username, not free text. Same users doc as isDeveloper.
        && request.resource.data.submitterUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;

      // The submitter can still edit their own submission while it's pending (fix a typo before
      // review); once the admin has reviewed it (approved or rejected), it's a permanent record --
      // only the admin can touch a reviewed submission (e.g. to correct a reviewNote).
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == resource.data.submitterUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.submitterUid == resource.data.submitterUid
            && request.resource.data.get('submitterUsername', '') == resource.data.get('submitterUsername', ''))
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.submitterUid && resource.data.status == 'pending';
    }

    // Landing page's raw page-view counter (index.html only). meta/siteStats is pre-created by
    // hand via the console with just {pageViews: 0} -- allow create is deliberately false so a
    // client can never spoof its shape or seed an arbitrary starting value. Anonymous write is
    // intentional (most visitors aren't signed in and should still be counted), but constrained
    // to exactly a same-field +1 per write: FieldValue.increment() resolves before rules
    // evaluate, so request.resource.data.pageViews already reflects the post-increment value here
    // -- a client still can't ever set it to an arbitrary/negative number or touch any other key.
    // meta/siteSettings -- admin-only site config, currently just hideGamesGrid (a testing switch
    // that hides the homepage's whole games grid for every visitor, admin included, so the admin
    // can see exactly what the public sees while it's on). Unlike siteStats above, this one IS
    // self-service-creatable (by the admin only) since there's only one admin and no meaningful
    // "wrong starting value" risk the way an anonymous-writable counter has.
    match /meta/{docId} {
      allow read: if true;
      allow create: if docId == 'siteSettings' && isAdmin()
        && request.resource.data.keys().hasOnly(['hideGamesGrid'])
        && request.resource.data.hideGamesGrid is bool;
      allow update: if (docId == 'siteStats'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews'])
          && request.resource.data.pageViews == resource.data.pageViews + 1)
        || (docId == 'siteSettings' && isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hideGamesGrid'])
          && request.resource.data.hideGamesGrid is bool);
      allow delete: if false;
    }

    // pageViews/{pathKey} + pageViewsDaily/{pathKey_YYYYMMDD} -- site-wide per-page traffic,
    // written by auth.js's trackPageView() on every page load (every game board, the homepage,
    // account/admin/user pages). pageViews (the running total) is publicly readable -- each
    // play/{slug}/index.html page displays its own "played N times" count straight off this same
    // doc, same non-sensitive aggregate-count precedent as index.html's own public traffic
    // counter. pageViewsDaily stays admin-only (isAdmin()), it only ever feeds admin/index.html's
    // Site Stats panel's today/last-7-days totals, nothing public reads it. Separate from
    // meta/siteStats above (index.html's own single-number visible counter, pre-seeded by hand)
    // -- these are self-service documents instead, since new pages/days appear over time and
    // pre-seeding one by hand for each isn't practical. Same FieldValue.increment()-resolves-
    // before-rules-evaluate trick as meta/siteStats keeps a client from setting either counter to
    // an arbitrary value: a create must start at exactly 1, and an update may only step the count
    // field by exactly +1, touching no other field.
    match /pageViews/{pathKey} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['path', 'total', 'lastViewedAt'])
        && request.resource.data.path is string
        && request.resource.data.total == 1
        && request.resource.data.lastViewedAt is int;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'lastViewedAt'])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.lastViewedAt is int;
      allow delete: if false;
    }
    match /pageViewsDaily/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['path', 'date', 'count'])
        && request.resource.data.path is string
        && request.resource.data.date is string
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // mail/{id} -- watched by functions/index.js's own sendMail (a plain Firestore-triggered
    // Cloud Function, Admin SDK only), which turns each doc into a real email sent through
    // support@ngpc-dev.com and writes delivery status back onto it. Previously watched by
    // Firebase's prebuilt "Trigger Email" extension instead -- swapped out since that extension is
    // being sunset (March 2027); this rule (who can write what) is unchanged either way. Written by
    // auth.js's notifyAdmin() on a new signup and by dev/submit/index.html on a new game submission
    // -- the recipient there is hardcoded to a single literal address, NOT just trusted from the
    // client, so nothing a client sends can redirect a notification to an arbitrary inbox; that's a
    // fixed admin alert channel, not a general mailer. auth.js's notifyUser() (admin/index.html's
    // own account-approval notice) is the one exception: it can address a real player instead, but
    // ONLY the site admin can send one, and ONLY to that exact account's own registered recovery
    // email -- the `uid` field is required and the `to` address is checked server-side against
    // users/{uid}/private/contact.recoveryEmail, so even a compromised admin-panel script couldn't
    // redirect this to somewhere else. No read/update/delete for any client either way: only
    // sendMail's own Admin SDK (which bypasses rules entirely) ever touches a doc after creation.
    match /mail/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && (
        (request.resource.data.keys().hasOnly(['to', 'message'])
          && request.resource.data.to is list
          && request.resource.data.to.size() == 1
          && request.resource.data.to[0] == 'support@ngpc-dev.com'
          && request.resource.data.message is map
          && request.resource.data.message.keys().hasOnly(['subject', 'text'])
          && request.resource.data.message.subject is string
          && request.resource.data.message.text is string)
        || (isAdmin()
          && request.resource.data.keys().hasOnly(['to', 'message', 'uid'])
          && request.resource.data.to is list
          && request.resource.data.to.size() == 1
          && request.resource.data.message is map
          && request.resource.data.message.keys().hasOnly(['subject', 'text'])
          && request.resource.data.message.subject is string
          && request.resource.data.message.text is string
          && request.resource.data.uid is string
          && request.resource.data.to[0] == get(/databases/$(database)/documents/users/$(request.resource.data.uid)/private/contact).data.recoveryEmail)
      );
    }

    // scoresArchive/{id} -- where admin/game/'s "Reset leaderboard" moves a game's old scores (a copy of
    // each score doc plus originalId/resetId/archivedAt) instead of destroying them. Admin-only on
    // every operation; append-only (no update/delete) so an archive can't be quietly rewritten.
    match /scoresArchive/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.resetId is string
        && request.resource.data.originalId is string
        && request.resource.data.archivedAt is int;
      allow update, delete: if false;
    }

    // passwordResetRequests/{id} -- the ONLY client-writable step of the password reset flow (see
    // functions/index.js's handlePasswordResetRequest, which is what actually reacts to these).
    // Deliberately open to anyone, signed in or not -- "forgot password" has to work while signed
    // out by definition, and the admin Players table (admin/index.html) writes the exact same shape
    // for its own "Reset password" button, so there's no separate privileged path to gate here. The
    // Cloud Function does its own uid-existence check, recovery-email lookup, and per-uid throttle
    // server-side (via the Admin SDK, which bypasses these rules entirely) -- this rule only pins
    // the shape so a client can't smuggle extra fields onto the doc. No read/update/delete: once
    // written, only the function (as admin) ever touches it again.
    match /passwordResetRequests/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['uid', 'requestedAt'])
        && request.resource.data.uid is string
        && request.resource.data.requestedAt is int;
    }

    // passwordResets/{token} -- the one-time reset token minted by handlePasswordResetRequest and
    // consumed by the confirmPasswordReset HTTPS function (functions/index.js), which calls it with
    // the Admin SDK -- entirely invisible to Firestore rules either way. No client of any kind
    // (including a signed-in admin) has any business reading or writing this collection directly,
    // so it's closed on every operation; this match exists purely so the schema is documented here
    // rather than only inside the function.
    match /passwordResets/{token} {
      allow read, write: if false;
    }

    // bw_career/{uid} -- a player's Neo Bowling career totals, from the cart's OPTIONS > STATS
    // CODE (decoded and checked in bw/index.html's decodeStatsCode(); the raw code is kept too).
    // Public read like scores; only the owner writes their own doc, under their real username.
    match /bw_career/{uid} {
      function isU16(v) { return v is int && v >= 0 && v <= 65535; }
      function isBowlingCareer(d) {
        return d.keys().hasOnly(['uid', 'username', 'submittedAt', 'version', 'code', 'hasBest', 'bestIni', 'bestScore', 'bestColor', 'bestHcp',
                                 'games', 'frames', 'strikes', 'spares', 'turkeys', 'vsGames', 'vsFrames', 'vsStrikes', 'vsSpares', 'vsTurkeys',
                                 'vsWins', 'vsLosses', 'avg10', 'avgGames', 'defIni'])
          && d.uid == uid
          && d.username is string && d.username == get(/databases/$(database)/documents/users/$(uid)).data.username
          && d.submittedAt is int
          && d.submittedAt <= request.time.toMillis() + 300000
          && d.submittedAt >= request.time.toMillis() - 300000
          && d.version == 1
          && d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{6,64}$')
          && d.hasBest is bool
          && d.bestIni is string && d.bestIni.matches('^[A-Z]{3}$')
          && d.bestScore is int && d.bestScore >= 0 && d.bestScore <= 330
          && d.bestColor is int && d.bestColor >= 0 && d.bestColor <= 15
          && d.bestHcp in [0, 10, 20, 30]
          && isU16(d.games) && isU16(d.frames) && isU16(d.strikes) && isU16(d.spares) && isU16(d.turkeys)
          && isU16(d.vsGames) && isU16(d.vsFrames) && isU16(d.vsStrikes) && isU16(d.vsSpares) && isU16(d.vsTurkeys)
          && isU16(d.vsWins) && isU16(d.vsLosses)
          && d.avg10 is int && d.avg10 >= 0 && d.avg10 <= 3000
          && isU16(d.avgGames)
          && d.defIni is string && d.defIni.matches('^[A-Z]{3}$');
      }
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && isBowlingCareer(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Default-deny for every other collection -- Firestore denies unmatched
    // paths by default anyway, but this makes the intent explicit as the
    // schema grows (Phase 3 comments/, etc).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
